var heroCards=document.querySelectorAll('.hero-card-item'),cardCount=heroCards.length;if(cardCount){var cardIndex=0;setInterval(function(){heroCards.forEach(function(e,t){e.style.opacity=t===cardIndex?'1':'.4';e.style.transform=t===cardIndex?'translateY(0) scale(1)':'translateY(10px) scale(.95)';e.style.transition='all .6s cubic-bezier(.4,0,.2,1)'});cardIndex=(cardIndex+1)%cardCount},4000)}
